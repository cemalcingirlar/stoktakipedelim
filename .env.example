# SQLite veritabanı dosyası (sunucuda kalıcı bir yol verin, örn. file:/var/lib/stok/stok.db)
DATABASE_URL="file:./dev.db"

# Oturum çerezlerini imzalayan gizli anahtar — üretimde MUTLAKA değiştirin.
# Üretmek için: openssl rand -base64 48
OTURUM_SIFRESI="degistirin-en-az-32-karakterlik-rastgele-bir-deger"

# ---------------------------------------------------------------- Yedekleme
# Google Drive'a günlük otomatik yedek. Kişisel Gmail hesapları için OAuth
# yöntemini kullanın; jetonu almak için: npm run drive:jeton
GOOGLE_ISTEMCI_ID=""
GOOGLE_ISTEMCI_SIRRI=""
GOOGLE_YENILEME_JETONU=""

# Yedeklerin yükleneceği Drive klasörünün kimliği (klasör URL'sinin son parçası).
# Boş bırakılırsa Drive köküne yüklenir.
GOOGLE_DRIVE_KLASOR_ID=""

# Alternatif: servis hesabı. Kendi depolama kotası olmadığı için yalnız
# Ortak Drive (Shared Drive) klasörlerine yükleyebilir; Google Workspace gerekir.
# Değer JSON'un kendisi veya anahtar dosyasının yolu olabilir.
GOOGLE_SERVIS_HESABI_JSON=""

# Drive'da tutulacak yedek sayısı; daha eskiler otomatik silinir.
YEDEK_SAKLAMA="14"

# /api/yedek ucunu koruyan gizli anahtar (en az 16 karakter).
# Üretmek için: openssl rand -hex 24
YEDEK_ANAHTARI=""
